<div style="color: grey;">
    {# {{ form(form)  }} #}
    {{  form_start(form, { attr: { novalidate: 'novalidate' }}) }}
      {{ form_errors(form) }}
      <div>
        {{ form_label(form.title, 'Enter a title', {
          label_attr: {
            class: 'block text-sm text-gray-700 dark:text-gray-300 font-medium'
          }
        }) }}
        {{ form_widget(form.title, { 
          attr: { 
            class: 'block w-full shadow-sm border-gray-300 dark:border-transparent dark:text-gray-800 rounded-md border p-2 mt-1 mb-2'
           }
        }) }}
        {{ form_errors(form) }}
      </div>

      <div>{{ form_label(form.text, 'Enter text content', {
         label_attr: {
            class: 'block text-sm text-gray-700 dark:text-gray-300 font-medium'
          }
        }) }}
        {{ form_widget(form.text, {
          attr: { 
            class: 'block w-full shadow-sm border-gray-300 dark:border-transparent dark:text-gray-800 rounded-md border p-2 mt-1 mb-2'
           }
        }) }}
        {{ form_errors(form) }}
      </div>

      {{ form_row(form.created, {
        label: 'Created at',
        label_attr: { class: 'block text-sm text-gray-700 dark:text-gray-300 font-medium' },
        attr: {
          class:  'block w-full shadow-sm border-gray-300 dark:border-transparent dark:text-gray-800 rounded-md border p-2 mt-1 mb-2'
        }
      }) }}

      <button type="submit" class="block w-full shadow-sm border-transparent bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400 text-white rounded-md border p-2 mt-4 mb-2">Save Post</button>
      
      {{ form_rest(form) }}
    {{ form_end(form) }}
  </div>